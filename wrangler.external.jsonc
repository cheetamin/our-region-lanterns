{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "our-region-lanterns",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "FILE_STORAGE": "d1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "our-region-lanterns-db",
      "database_id": "b77c0d7b-0882-4763-9fd3-8d128bf5395b",
      "migrations_dir": "drizzle"
    }
  ]
}
