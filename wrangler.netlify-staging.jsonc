{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "our-region-netlify-staging",
  "main": "worker/external.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "FILE_STORAGE": "d1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "our-region-netlify-staging-db",
      "database_id": "46f47d93-dfa5-4ce8-b5ba-33fc98623ed8",
      "migrations_dir": "drizzle"
    }
  ]
}
